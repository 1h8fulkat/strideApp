# --- local configuration, never committed -----------------------------------
# Home Assistant URL, token and broker credentials.
homeassistant/stride.conf
# Broker credentials injected into the console build, and the Android SDK
# path, which is a home directory and differs per machine.
console/*/local.properties

# The release signing key. It belongs outside the repo entirely — see the
# keytool line in console/stride/app/build.gradle.kts — but a key committed
# once is a key that has to be replaced and every install re-done, so this is
# here as a second lock rather than as the only one.
*.jks
*.keystore
*.p12

# --- build output -----------------------------------------------------------
console/*/build/
console/*/app/build/
console/*/.gradle/
*.iml
.idea/

# Build logs from whatever machine last built this.
console/*/build-debug.out
console/*/build-debug.err

# An Android SDK unpacked into the project directory. This is 158 MB of
# redistributable toolchain that arrived here once by accident and is not part
# of the project — the container in tools/docker carries its own. See
# docs/DOCKER.md.
console/*/lib/
console/*/bin/
console/*/source.properties
console/*/NOTICE.txt

# Console data pulled off the treadmill by tools/docker-deploy.sh before an
# uninstall: settings, the people on the console, and the walk history. Yours,
# and nobody else's business.
.backups/

# --- private working notes --------------------------------------------------
# The build journal, session plans and the v1.0 prep document. Kept locally
# because they are useful, out of git because every one of them names people,
# quotes health data, and works through a specific house's setup. The prep
# document is the worst offender: it lists exactly which personal facts had to
# come out of the code, which rather defeats the point of taking them out.
docs/journal/

# --- anything archived out of the public tree -------------------------------
archive/

.DS_Store

# Python leaves these beside the Home Assistant scripts when they are imported.
__pycache__/
*.pyc
