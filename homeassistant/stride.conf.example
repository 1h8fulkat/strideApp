# STRIDE — configuration for the Home Assistant side.
#
#     cp stride.conf.example stride.conf
#
# `stride.conf` is gitignored. Every script in this directory reads it.
#
# The treadmill itself needs none of this — the console registers itself in
# Home Assistant over MQTT. This is for the extras: the coach, the reminders,
# the dashboard and the Apple Health webhook.
#
# Leave anything blank and that subject is just absent. No scale, no BP cuff,
# no phone — the coach won't mention what it wasn't given.


# === Required, for anything in this directory to run =======================

# Where Home Assistant is, as these scripts will reach it.
ha_url: http://homeassistant.local:8123

# Profile -> Security -> Long-lived access tokens -> Create token.
ha_api_token: paste-yours-here

# The MQTT broker Home Assistant uses. Host, or tcp://host:port.
# The same details you put into the console's Settings -> Home Assistant.
#
# OPTIONAL. Filled in, these scripts publish straight to the broker with
# mosquitto_pub, which has to be installed (apt install mosquitto-clients).
# Left blank, they ask Home Assistant to publish for them over its API
# instead — it is already connected to the broker, so there is nothing to
# install and no second copy of the broker password to keep. The direct
# route is used when it is available because a broker that refuses a publish
# should say so itself.
mqtt_broker:
mqtt_user:
mqtt_pass:


# === The coach =============================================================

# Which AI task entity writes the coach's lines. No default, because it depends
# on your integration — and a wrong one fails later with an unhelpful error.
# Find yours in Developer Tools -> States, filtered to `ai_task.`.
coach_ai_task: ai_task.your_ai_task_here

# What the coach calls you. Blank and it says "there", which reads fine.
walker_name:

# Your working weight target in kg, if you have one. Shared with the dashboard.
# Blank and the coach says nothing about a goal and the dashboard draws no
# target line.
weight_target_kg:

# Subjects the coach must not comment on. Free text - "my blood pressure", "my
# weight", "anything about sleep" - passed through as an instruction. It won't
# give medical advice or express concern either way; this is for anything else
# you'd rather it left alone.
coach_avoid:

# Where a coach message is pushed. Find yours under `notify.` in Developer
# Tools -> Actions. Blank falls back to a persistent notification in Home
# Assistant, which is visible but does not reach a phone.
notify_service:


# === Your treadmill's entities =============================================

# The console's device is called "Treadmill", so its entities are
# `sensor.treadmill_speed`, `sensor.treadmill_distance` and so on. If you
# renamed the device in Home Assistant, put the new prefix here — and change
# the sources in packages/stride.yaml to match.
treadmill_prefix: treadmill

# The console's ADB address, for the tools that read the treadmill directly
# rather than going through the broker — `stride_routes.py console`, mainly.
# Leave it blank and they ask adb what is attached, which is usually right.
# Fill it in if you keep more than one Android device plugged into this
# machine. Remember it is only reachable while ADB over Wi-Fi is up, which
# does not survive a power cycle — see docs/INSTALL.md.
console_adb:



# === Routes from GPX files =================================================
# Only needed if you use stride_gpx.py to turn recorded walks into routes.

# Where the .gpx files live on Home Assistant, as a path under `www/`. With
# the default, `config/www/treadmill/routes/friday-loop.gpx` is served at
# `<ha_url>/local/treadmill/routes/friday-loop.gpx` and becomes a route
# called "Friday loop" — the filename is the name, so name it well.
ha_gpx_path: treadmill/routes

# HOW THE FILES ARE FOUND. Home Assistant serves that folder but will not list
# it: `/local/` answers 403 to a directory request and no API enumerates it.
# So pick one of these two.
#
# EITHER a `folder` sensor, which is a listing that maintains itself — drop a
# file in and it appears, with nothing else to edit ever again. Put this in
# configuration.yaml and restart:
#
#     homeassistant:
#       allowlist_external_dirs:
#         - /config/www/treadmill/routes
#     sensor:
#       - platform: folder
#         folder: /config/www/treadmill/routes
#         filter: "*.gpx"
#
# then name the entity it creates here:
gpx_folder_sensor:

# OR, leaving that blank, an `index.json` sitting beside the .gpx files:
#
#     ["friday-loop.gpx", "the-hill.gpx"]
#
# Nothing to configure in Home Assistant, but you edit it when you add a walk.

# A plain local folder instead, for running this on the machine that holds the
# files. Only consulted when neither of the above is available.
gpx_dir:

# What your deck can do, in percent. Used only so the numbers printed at
# import match the walk you will get: the console clamps to whatever its own
# board reports regardless. The defaults are a NordicTrack C 1750's, and the
# floor is the one that bites — no treadmill descends like a hill.
deck_min_grade: -3
deck_max_grade: 15

# === Apple Health, via the iOS companion app ===============================
# Only needed if you use the app. Skip all of this otherwise.

# Externally reachable base URL for your Home Assistant, so the app can post
# from outside the house.
ha_external_url: https://your-home-assistant.example.com

# The webhook id the app posts to. This is the only thing protecting that
# endpoint, so generate 30 random characters and keep them to yourself:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(22)[:30])"
stride_webhook_id: generate-your-own

# Your phone's step sensor, if the Home Assistant companion app provides one.
# Used only as a fallback when Apple Health has not synced yet.
phone_steps_entity:


# === A Withings scale or blood-pressure cuff ================================
# All optional. Leave blank if you do not have them.

# Home Assistant names Withings entities after the device the integration was
# set up against, so this differs per install. Check Developer Tools -> States
# for something like `sensor.something_withings_weight` and put everything up
# to and including `withings_` here.
withings_prefix: sensor.withings_

# Individual entities, if they do not follow that prefix.
weight_entity:
body_fat_entity:
systolic_entity:
diastolic_entity:
withings_steps_entity:


# === The dashboard ==========================================================

# Console walkers to show treadmill tiles for, comma separated, using the ids
# the console publishes - usually first names in lower case:
#
#     console_people: sam,alex
#
# Blank is fine; the entities exist either way under their own STRIDE devices.
console_people:
